(function() {
    function initTherapyRouteFAQ(root) {
        if (root.hasAttribute('data-tr-init')) return;
        root.setAttribute('data-tr-init', 'true');
 
        function unpinAll(except) {
            root.querySelectorAll('.tr-ref a[data-pinned]').forEach(a => {
                if (a !== except) a.removeAttribute('data-pinned');
            });
        }
 
        root.addEventListener('click', function(e) {
            const link = e.target.closest('.tr-ref a, sup > a');
            
            // Accordion Logic
            const summary = e.target.closest('summary');
            if (summary) {
                e.preventDefault(); 
                const details = summary.parentElement;
                const wasOpen = details.hasAttribute('open');
                
                if (!wasOpen) {
                    const parent = details.parentElement;
                    if (parent) {
                        parent.querySelectorAll(':scope > details[open]').forEach(sib => {
                             if (sib !== details) sib.removeAttribute('open');
                        });
                    }
                    details.setAttribute('open', '');
                    setTimeout(() => {
                        if (details.scrollIntoView) {
                            details.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                        }
                    }, 50);
                } else {
                    details.removeAttribute('open');
                }
                return;
            }
 
            // Tooltip Logic
            if (!link) {
                unpinAll();
                return;
            }
            if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
            
            if (!link.hasAttribute('data-pinned')) {
                e.preventDefault();
                unpinAll(link);
                link.setAttribute('data-pinned', '');
                link.focus();
            } else {
                setTimeout(() => unpinAll(), 0);
            }
        });
 
        root.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') unpinAll();
        });
        
        document.addEventListener('click', function(e) {
             if (!root.contains(e.target)) unpinAll();
        }, true);
    }
 
    document.querySelectorAll('.therapyroute-faq').forEach(initTherapyRouteFAQ);
})();
