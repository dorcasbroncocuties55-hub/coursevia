# ══════════════════════════════════════════════════════════════════════════════
# STRIPE CONNECT ENVIRONMENT VARIABLES
# Copy these to your backend/.env file
# ══════════════════════════════════════════════════════════════════════════════

# Stripe API Keys (Get from: https://dashboard.stripe.com/apikeys)
# Use test keys (sk_test_...) for development, live keys (sk_live_...) for production
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxx

# Stripe Webhook Secrets (Get from: https://dashboard.stripe.com/webhooks)
# After creating webhook endpoint, reveal and copy the signing secret
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

# Your Application URL (used for onboarding redirects)
APP_URL=https://coursevia.com

# Supabase Configuration (you should already have these)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ══════════════════════════════════════════════════════════════════════════════
# QUICK SETUP CHECKLIST
# ══════════════════════════════════════════════════════════════════════════════

# 1. Enable Stripe Connect in dashboard
# 2. Create webhook endpoint at: /api/stripe-connect/webhook
# 3. Copy webhook secret and API keys above
# 4. Run database migration (STRIPE_CONNECT_MIGRATION.sql)
# 5. Restart backend server
# 6. Test with provider onboarding endpoint

# ══════════════════════════════════════════════════════════════════════════════
# TESTING
# ══════════════════════════════════════════════════════════════════════════════

# For testing, use Stripe test mode:
# - Test cards: 4242 4242 4242 4242
# - Test routing number: 110000000
# - Test account number: 000123456789
# - Any future expiry date and CVV

# Stripe Test Mode Dashboard: https://dashboard.stripe.com/test/
